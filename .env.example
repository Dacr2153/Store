# ─────────────────────────────────────────────────────────────────────────────
# FinalStore — Variables de entorno
# Copia este archivo a .env y ajusta los valores antes de hacer deploy
#
#   cp .env.example .env
#   docker compose -f docker-compose.prod.yml up -d --build
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de datos ─────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=finalstore

# ── Backend ───────────────────────────────────────────────────────────────────
# Cambia esto por una cadena aleatoria larga (mínimo 32 caracteres)
JWT_SECRET=cambia-esto-por-algo-muy-secreto-y-largo-123456

# Puerto donde se expone la app web (por defecto: 80)
APP_PORT=80

# ── Stripe — pagos reales (opcional) ─────────────────────────────────────────
# Si no se configura, el sistema usa pagos simulados (mock) automáticamente
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Google OAuth (opcional) ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost/api/auth/google/login

# ── Email (opcional) ──────────────────────────────────────────────────────────
# Si no se configura, los emails se imprimen en los logs del backend
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── IA local — Ollama (opcional) ──────────────────────────────────────────────
# Instala Ollama en tu máquina: https://ollama.com
# Si no se configura, el chat IA no estará disponible
OLLAMA_HOST=http://host.docker.internal:11434
